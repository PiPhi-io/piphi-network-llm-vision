{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-llm-vision",
  "name": "LLM vision sidecar",
  "version": "0.1.0",
  "description": "Run bounded, opt-in vision analysis for explicitly brokered camera media.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "sidecar-worker",
    "domain": "sidecar-service",
    "preset_summary": "Sidecar starter with service health and queue-oriented command hooks."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "docker.io/piphinetwork/piphi-network-llm-vision:0.1.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "docker.io/piphinetwork/piphi-network-llm-vision:0.1.0",
        "ports": [
          {
            "container": 4209,
            "host": 4209
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "alias",
      "service_name"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host"
    ]
  },
  "identity": {
    "fields": [
      "host"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 5000
    }
  },
  "entities": [
    {
      "id": "llm-vision-service",
      "name": "LLM Vision Service",
      "device_id": "llm-vision-service",
      "entity_type": "service",
      "capabilities": [
        "connected",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "LLM vision sidecar",
    "summary": "Run bounded, opt-in vision analysis for explicitly brokered camera media.",
    "category": "camera",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-llm-vision/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Discovers or communicates with supported services and devices on the homeowner's local network.",
        "required": true
      },
      {
        "id": "credentials",
        "label": "Account or device credentials",
        "reason": "Authenticates only to the configured vendor account, service, or local device and keeps credentials out of state and diagnostics.",
        "required": true
      },
      {
        "id": "brokered_media",
        "label": "Brokered camera media",
        "reason": "Processes media only after an explicit widget, automation, or analysis request through the PiPhi media broker.",
        "required": false
      },
      {
        "id": "sidecar_runtime",
        "label": "Managed sidecar runtime",
        "reason": "Runs as an isolated helper service consumed by a parent PiPhi integration.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "PiPhi Network",
        "model": "Brokered camera media and configured vision providers"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-llm-vision",
    "support_url": "https://github.com/PiPhi-io/piphi-network-llm-vision/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-llm-vision/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "vision analysis service"
    ],
    "protocols": [
      "PiPhi media broker",
      "configured vision provider API",
      "HTTPS"
    ],
    "discovery_methods": [
      "manual service configuration"
    ],
    "connectivity": "hybrid",
    "offline_support": "partial",
    "privacy_url": "https://github.com/PiPhi-io/piphi-network-llm-vision/blob/main/docs/privacy.md"
  }
}
