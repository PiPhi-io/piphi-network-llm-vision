{
  "catalog_version": "1.0",
  "integration_id": "piphi-network-llm-vision",
  "coverage_mode": "sidecar_provider_media_queue_and_privacy",
  "reviewed_at": "2026-09-07",
  "sources": {
    "llm_vision": "https://github.com/valentinfrlch/ha-llmvision",
    "llm_vision_services": "https://github.com/valentinfrlch/ha-llmvision/blob/main/custom_components/llmvision/services.yaml",
    "llm_vision_docs": "https://llmvision.gitbook.io/getting-started",
    "provider_contracts": "Maintained provider APIs selected by the user",
    "media_broker": "PiPhi managed camera media sidecar contract",
    "core_vocabulary": "PiPhi Network Core and maintained PiPhi integrations"
  },
  "groups": [
    {
      "id": "runtime-foundation",
      "status": "implemented",
      "scope": ["sidecar-service"],
      "source_refs": ["core_vocabulary"],
      "reason": "The scaffold implements sidecar configuration presence, connectivity state, refresh dispatch, and configuration events.",
      "state": ["connected"],
      "events": ["runtime.config.applied"],
      "conditions": [],
      "actions": ["refresh"]
    },
    {
      "id": "analysis-jobs-and-results",
      "status": "planned",
      "scope": ["explicitly-submitted-images", "explicitly-submitted-videos", "brokered-camera-streams"],
      "source_refs": ["llm_vision", "llm_vision_services", "llm_vision_docs", "media_broker"],
      "reason": "Image, video, and stream analysis need bounded media ingestion, typed job schemas, consent gates, and deterministic mocked-provider tests.",
      "state": ["job_status", "job_type", "job_created_at", "job_started_at", "job_completed_at", "analysis_summary", "analysis_title", "analysis_structured_result", "analysis_confidence", "key_frame_reference", "source_camera_id", "frames_sampled", "input_media_duration_s", "response_truncated"],
      "events": ["analysis.queued", "analysis.started", "analysis.completed", "analysis.failed", "analysis.cancelled", "semantic_event.detected"],
      "conditions": ["analysis_status_is", "analysis_confidence_threshold", "semantic_label_is", "source_camera_is", "analysis_age_threshold"],
      "actions": ["analyze_image", "analyze_video", "analyze_stream", "cancel_analysis"]
    },
    {
      "id": "provider-routing-and-usage",
      "status": "planned",
      "scope": ["configured-local-or-cloud-providers", "provider-supported-media-and-output-modes"],
      "source_refs": ["llm_vision", "llm_vision_docs", "provider_contracts"],
      "reason": "Provider features, model availability, structured output, memory, rate limits, and fallback support differ and must be negotiated per configuration.",
      "state": ["provider_name", "model_name", "provider_available", "provider_latency_ms", "provider_error_count", "provider_rate_limited", "input_tokens", "output_tokens", "estimated_cost", "structured_output_supported", "multi_image_supported", "video_supported", "memory_supported", "fallback_provider_name", "fallback_used"],
      "events": ["provider.failed", "provider.recovered", "provider.rate_limited", "provider.fallback_used", "usage.threshold_crossed"],
      "conditions": ["provider_is_available", "provider_is", "model_is", "provider_is_rate_limited", "estimated_cost_threshold", "token_usage_threshold", "fallback_was_used"],
      "actions": ["test_provider", "refresh_provider_models"]
    },
    {
      "id": "timeline-and-retention",
      "status": "planned",
      "scope": ["timeline-enabled-configurations"],
      "source_refs": ["llm_vision", "llm_vision_services", "llm_vision_docs"],
      "reason": "Timeline storage is optional persistent state with retention, filtering, redaction, and ownership requirements.",
      "state": ["timeline_enabled", "timeline_event_count", "timeline_last_event_at", "timeline_retention_days", "timeline_storage_bytes", "daily_summary", "timeline_categories", "timeline_labels"],
      "events": ["timeline.event_created", "timeline.event_updated", "timeline.event_deleted", "timeline.retention_purged", "timeline.summary_created"],
      "conditions": ["timeline_has_events", "timeline_category_is", "timeline_label_is", "timeline_event_count_threshold"],
      "actions": ["create_timeline_event", "update_timeline_event", "delete_timeline_event", "purge_expired_timeline", "summarize_timeline"]
    },
    {
      "id": "memory-and-reference-context",
      "status": "planned",
      "scope": ["explicitly-enabled-memory", "providers-supporting-multi-image-context"],
      "source_refs": ["llm_vision", "llm_vision_docs", "provider_contracts"],
      "reason": "Reference memory can identify household context and therefore requires explicit enrollment, access control, deletion, and provider capability checks.",
      "state": ["memory_enabled", "memory_entry_count", "memory_last_updated_at", "memory_provider_supported"],
      "events": ["memory.entry_added", "memory.entry_removed", "memory.cleared"],
      "conditions": ["memory_is_enabled", "memory_has_entries", "memory_provider_is_supported"],
      "actions": ["add_memory_entry", "remove_memory_entry", "clear_memory"]
    },
    {
      "id": "sidecar-operations-and-backpressure",
      "status": "planned",
      "scope": ["sidecar-worker", "parent-camera-integrations"],
      "source_refs": ["core_vocabulary", "media_broker"],
      "reason": "As a sidecar, it must model queueing, dependency loss, retries, saturation, recovery, and degraded health before accepting real analysis work.",
      "state": ["service_available", "queue_depth", "queue_capacity", "active_job_count", "worker_count", "oldest_job_age_s", "jobs_completed_total", "jobs_failed_total", "jobs_retried_total", "media_broker_connected", "degraded_reason", "last_success_at"],
      "events": ["queue.saturated", "queue.recovered", "worker.started", "worker.stopped", "worker.failed", "dependency.lost", "dependency.recovered", "job.retry_scheduled"],
      "conditions": ["queue_depth_threshold", "queue_is_saturated", "worker_is_healthy", "dependency_is_available", "last_success_age_threshold"],
      "actions": ["drain_queue", "retry_failed_job"]
    },
    {
      "id": "privacy-security-and-unsafe-surface",
      "status": "excluded",
      "scope": ["all-providers-and-media"],
      "source_refs": ["llm_vision", "llm_vision_docs", "provider_contracts", "media_broker"],
      "reason": "Secrets, raw media bytes, unrestricted filesystem/URL access, hidden continuous surveillance, autonomous device control, and unconstrained biometric identification are outside the safe sidecar contract.",
      "state": ["provider_api_key", "provider_credentials", "raw_image_bytes", "raw_video_bytes", "unredacted_prompt_log", "biometric_identity_embedding"],
      "events": [],
      "conditions": [],
      "actions": ["analyze_arbitrary_url", "read_arbitrary_file", "write_arbitrary_file", "execute_provider_tool", "control_detected_device", "enable_continuous_surveillance", "identify_unknown_person_biometrically"]
    }
  ]
}
